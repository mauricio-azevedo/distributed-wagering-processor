# Copy to .env. Bun loads it for make dev and make test; Docker Compose reads HTTP_PORT from it.
HTTP_PORT=3000
# Compose publishes PostgreSQL on 5433; the passwords are set in docker/postgres/01-roles.sql.
DATABASE_URL=postgres://wagering_app:wagering_app@localhost:5433/wagering
MIGRATION_DATABASE_URL=postgres://wagering_migrator:wagering_migrator@localhost:5433/wagering
# LocalStack accepts any credentials.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
