# Copy to .env. Bun loads it for make dev and make test; Docker Compose reads the ports from it.
# The three ports are the ones a single checkout publishes: make overrides them per checkout, and
# the URLs below follow whichever values are in force, so they always reach the containers make
# started. Run make stack to see them for this checkout.
HTTP_PORT=3000
POSTGRES_PORT=5433
LOCALSTACK_PORT=4566
# The passwords are set in docker/postgres/01-roles.sql.
DATABASE_URL=postgres://wagering_app:wagering_app@localhost:${POSTGRES_PORT}/wagering
MIGRATION_DATABASE_URL=postgres://wagering_migrator:wagering_migrator@localhost:${POSTGRES_PORT}/wagering
# conc.row-lock: how long a financial operation waits for a wallet row before answering 503 (ADR 0002).
LOCK_TIMEOUT_MS=3000
# LocalStack accepts any credentials.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:${LOCALSTACK_PORT}
# ADR 0005: the outbox publisher's batch, its publish timeout and how long it waits after a cycle
# that found nothing. The first two bound how long a cycle holds a database connection while it
# talks to the broker; none of the three changes what is guaranteed.
OUTBOX_BATCH_SIZE=50
OUTBOX_PUBLISH_TIMEOUT_MS=5000
OUTBOX_POLL_INTERVAL_MS=1000
# How long one receive waits for a message, and how long a received message stays invisible, which
# is how long the consumer has to commit it (msg.ack-after-commit). Both have defaults; these are
# them, spelled out so a deployment sees what it is overriding.
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=30
